RAILS_ENV=production
SECRET_KEY_BASE=replace-with-your-secret-key-base
DATABASE_HOST=postgres
DATABASE_USERNAME=broadcast
DATABASE_PASSWORD=replace-with-your-database-password
TLS_DOMAIN=replace-with-your-domain
LICENSE_KEY=replace-with-your-license-key

# Active Record encryption keys. Required: Broadcast encrypts two-factor
# secrets, backup credentials, and AI and Autopilot API keys with them.
# Generate each value with its own run of: openssl rand -hex 16
# Set all three. Never change them after the first start: a changed key makes
# the data encrypted with the old key unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-with-output-of-openssl-rand-hex-16
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-with-output-of-openssl-rand-hex-16
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-output-of-openssl-rand-hex-16

RAILS_ENV=production
SECRET_KEY_BASE=replace-with-your-secret-key-base
DATABASE_HOST=postgres
DATABASE_USERNAME=broadcast
DATABASE_PASSWORD=replace-with-your-database-password
TLS_DOMAIN=replace-with-your-domain
LICENSE_KEY=replace-with-your-license-key

# Active Record encryption keys. Required: Broadcast encrypts two-factor
# secrets, backup credentials, and AI and Autopilot API keys with them.
# Generate each value with its own run of: openssl rand -hex 16
# and paste it after the "=". Set all three; while one is empty, saving those
# values fails (Broadcast 2.49 and later also logs a warning at startup).
# Never change them after the first start: a changed key makes the data
# encrypted with the old key unreadable.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Log level. Broadcast logs at info by default. Set debug only for a short
# investigation: it logs every SQL statement, which can contain personal data
# and fills the disk quickly. Releases up to 2.50.2 ignore this setting and
# always log at debug.
# RAILS_LOG_LEVEL=info
